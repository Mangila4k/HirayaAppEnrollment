{
  "expo": {
    "name": "Placido L. Señor NHS",
    "slug": "plsnhs-enrollment",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/plsnhslogo.jpg",
    "scheme": "plsnhs",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.plsnhs.enrollment",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Placido L. Señor NHS Enrollment System uses your location to verify you are within the school premises when recording attendance.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/plsnhslogo.jpg",
        "backgroundColor": "#0B2A4A"
      },
      "package": "com.plsnhs.enrollment",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/plsnhslogo.jpg"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Placido L. Señor NHS Enrollment System to use your location to verify attendance.",
          "locationWhenInUsePermission": "Allow Placido L. Señor NHS Enrollment System to use your location to verify attendance.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-image",
      "expo-splash-screen",
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
  "supabaseUrl": "https://tuujlqrfyuazvbvoribz.supabase.co",
  "supabaseAnonKey": "sb_publishable_dYaVB2zNcNNj5gwjzJ4ZRw_N55Djq0D",
  "router": {}
}
  }
}
